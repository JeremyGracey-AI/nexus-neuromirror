# NeXus NeuroMirror — Vercel server-side environment variables
#
# Copy to `.env.local` for local `vercel dev`, and set the SAME values in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# These are SERVER-ONLY. Never expose GITHUB_TOKEN to the client or a VITE_* var.

# REQUIRED. Fine-grained GitHub personal access token with:
#   Repository access: JeremyGracey-AI/nexus-neuromirror
#   Permissions: Contents = Read and write
# The API fails clearly (HTTP 503) if this is absent. Uploads are disabled
# until it is set.
GITHUB_TOKEN=

# Optional overrides (defaults shown).
GITHUB_OWNER=JeremyGracey-AI
GITHUB_REPO=nexus-neuromirror
GITHUB_BRANCH=master

# Optional: GitHub Enterprise / proxy API base (default https://api.github.com).
# GITHUB_API_BASE=https://api.github.com

# Optional: override the upload size cap in bytes. Default 4194304 (4 MB).
# Keep this below Vercel's ~4.5 MB serverless request-body limit.
# NNM_MAX_UPLOAD_BYTES=4194304
